# Midtrans Sandbox Credentials
# Dapatkan di https://dashboard.sandbox.midtrans.com/settings/keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx

# App URL (sesuaikan saat deploy)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Supabase =====
# Project dashboard: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...
# Browser-safe version of SUPABASE_URL (same value, exposed to client)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# ===== Admin Auth =====
# Single password for /admin login (change in production!)
ADMIN_PASSWORD=change-me-now
# Random string 32+ char, used to sign JWT cookie
ADMIN_JWT_SECRET=replace-with-32-char-random-string-please

# ===== Everpro Shipping =====
# Get API key at https://developer.everpro.id/
EVERPRO_API_KEY=
EVERPRO_API_SECRET=
EVERPRO_CALLBACK_SECRET=
EVERPRO_BASE_URL=https://client-api-sandbox.everpro.id
EVERPRO_ENVIRONMENT=sandbox
STORE_ORIGIN_POSTAL_CODE=40391
STORE_SHIPPER_NAME=NXTY Fightwear
STORE_SHIPPER_PHONE=
STORE_SHIPPER_ADDRESS=

# Master key untuk mengenkripsi credential yang dimasukkan lewat admin.
# Generate sekali: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# ===== Telegram alert admin (opsional, gratis) =====
# Alert pesanan baru + bukti bayar masuk ke Telegram. Kosongkan = nonaktif.
# 1. Chat @BotFather di Telegram, kirim /newbot, ikuti langkahnya, copy token.
# 2. Bikin channel/grup, jadikan bot sebagai admin (channel) / member (grup).
# 3. chat_id: kirim 1 pesan di grup, buka
#    https://api.telegram.org/bot<TOKEN>/getUpdates -> ambil "chat":{"id":...}
#    (channel publik bisa pakai "@namachannel" langsung)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
